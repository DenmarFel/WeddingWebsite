# Copy to .env.local and fill in. See docs/ for setup details.

# Google service account with access to the guest list spreadsheet
GOOGLE_SHEETS_CLIENT_EMAIL=
# Paste the private key with literal \n line breaks, wrapped in quotes
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Password for /seating_chart
SEATING_CHART_PASSWORD=

# Optional: Maps Embed API key. Without it the map uses Google's keyless embed.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
